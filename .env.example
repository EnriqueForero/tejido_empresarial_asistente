# ─────────────────────────────────────────────────────────────────────────────
# Tejido Empresarial · ProColombia — variables de entorno
# Copie este archivo a `.env` sólo para desarrollo local. En Railway configure
# las variables desde el panel del servicio; nunca suba llaves al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# --- Snowflake (obligatorias en producción) ---------------------------------
SF_ACCOUNT=
SF_USER=
SF_DATABASE=APP_SEGMENTACION_EXPORTACIONES
SF_SCHEMA=SEGMENTACION
SF_WAREHOUSE=APPS_WH
SF_ROLE=APP_SEGMENTACION_EXPORTACIONES

# Llave privada RSA (DER) del usuario de servicio. En Railway use la versión Base64.
# Convertir: PowerShell  [Convert]::ToBase64String([IO.File]::ReadAllBytes("rsa_key_1.der"))
#            macOS/Linux base64 -w 0 rsa_key_1.der
SF_PRIVATE_KEY_B64_1=
SF_PRIVATE_KEY_PASSPHRASE_1=
# Segunda llave (rotación / respaldo). Opcional.
SF_PRIVATE_KEY_B64_2=
SF_PRIVATE_KEY_PASSPHRASE_2=
# Alternativa local a Base64: ruta en disco al archivo .der
SF_PRIVATE_KEY_PATH_1=
SF_PRIVATE_KEY_PATH_2=

# --- Aplicativo --------------------------------------------------------------
# production | development (development habilita /api/docs)
APP_ENV=development
# true = datos sintéticos, sin Snowflake. Útil para probar la interfaz.
APP_DEMO_MODE=false
# URL pública HTTPS del servicio (para metadatos sociales). Ej.: https://tejido.up.railway.app
PUBLIC_ORIGIN=
# Máximo de empresas por archivo Excel (1 a 20000).
EXPORT_MAX_ROWS=5000
# Incluir dirección, teléfono, correo y representante legal en la descarga (como en Streamlit).
EXPORT_INCLUDE_CONTACT_FIELDS=true
# Tamaño máximo del cuerpo HTTP en bytes.
MAX_REQUEST_BYTES=2000000

# Nivel de detalle de los registros: INFO (por defecto), DEBUG, WARNING.
LOG_LEVEL=INFO

# --- Acceso (opcional) --------------------------------------------------------
# Si se configuran AMBAS, todo el aplicativo pide usuario y contraseña (HTTP Basic).
# Si se dejan vacías, el acceso es abierto, igual que la versión Streamlit.
APP_BASIC_USER=
APP_BASIC_PASSWORD=

# Permite abrir /api/diagnostico en un despliegue de producción sin autenticación
# HTTP Basic: llame a /api/diagnostico?token=EL_MISMO_VALOR. Si configura
# APP_BASIC_USER y APP_BASIC_PASSWORD no hace falta.
APP_DIAG_TOKEN=

# --- Asistente de análisis (Snowflake Cortex) ---------------------------------
# El asistente NO necesita credenciales nuevas: firma la API de Cortex con la
# misma llave RSA de arriba. Lo único que hace falta en Snowflake es conceder
# SNOWFLAKE.CORTEX_USER y SELECT sobre la vista semántica (ver snowflake/01_permisos_asistente.sql).
# Todas estas variables tienen un valor por defecto correcto; se dejan por si
# cambia el nombre de la vista o el modelo de redacción.
SF_SEMANTIC_VIEW=APP_SEGMENTACION_EXPORTACIONES.SEGMENTACION.TEJIDO_EMPRESARIAL_SEGMENTACION
# Modelo de Cortex que redacta la respuesta. Los nombres caducan (claude-3-5-sonnet
# fue retirado); /estado → «Probar la redacción con IA» dice cuáles responden.
SF_CORTEX_MODEL=claude-haiku-4-5
# Esquemas donde se permite ejecutar la SQL generada, separados por coma.
SF_ALLOWED_SCHEMAS=APP_SEGMENTACION_EXPORTACIONES.SEGMENTACION,APP_SEGMENTACION_EXPORTACIONES.PUBLIC
# Host de la API REST. Sólo si su cuenta usa un dominio distinto al estándar
# <SF_ACCOUNT>.snowflakecomputing.com
SF_HOST=
# Topes del asistente.
IA_MAX_ROWS=5000
IA_MAX_ROWS_CLIENT=500
# Segundos de espera a Cortex Analyst por llamada (más de 45 casi siempre es un fallo).
IA_ANALYST_TIMEOUT=45
# Mensajes previos que se reenvían a Analyst para refinar (4 = dos preguntas anteriores).
IA_HISTORY_TURNS=4
# Resultados que el servidor conserva para descargar completos: cuántos y por cuántos segundos.
IA_RESULT_CAPACITY=50
IA_RESULT_TTL=1800
# Tras estos fallos seguidos, la redacción con IA se pausa estos segundos: una
# respuesta rápida con el resumen de los datos vale más que veinte segundos de espera.
IA_REDACCION_FALLOS_PARA_PAUSA=3
IA_REDACCION_PAUSA=600
# NIT reales de ejemplo (chips de la consulta, lote y pregunta sugerida), separados por coma.
NITS_EJEMPLO=890903938,811000740,890912462
# Tablas de métricas del asistente (crearlas con snowflake/03_telemetria_asistente.sql).
ASISTENTE_LOG_TABLE=APP_SEGMENTACION_EXPORTACIONES.SEGUIMIENTO.ASISTENTE_CONSULTAS
ASISTENTE_DOWNLOAD_TABLE=APP_SEGMENTACION_EXPORTACIONES.SEGUIMIENTO.ASISTENTE_DESCARGAS
# Plazo (segundos) que Snowflake da a cualquier sentencia del aplicativo, incluida la redacción.
SF_STATEMENT_TIMEOUT=300
